<component type="desktop-application">
  <id>io.github.lukasborges.Kondor</id>
  <name>Kondor Browser</name>
  <summary>A lightweight Qt/KDE web browser</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="io.github.lukasborges">
    <name>Lucas Borges</name>
  </developer>
  <description>
    <p>Kondor Browser is a small web browser that looks and behaves like a native KDE Plasma application: Breeze style, Breeze icons and your system color scheme.</p>
    <p>It blocks ads and trackers, keeps private tabs off the disk, and has reader mode, a download manager, bookmarks, history, site permissions and developer tools built in.</p>
  </description>
  <launchable type="desktop-id">io.github.lukasborges.Kondor.desktop</launchable>
  <url type="homepage">https://github.com/lukasborges/kondor</url>
